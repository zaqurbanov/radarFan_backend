{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/server.ts",
    "dev:test":"tsx watch --env-file=.env.test src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx  src/db/seed.ts",
    "db:reset": "tsx --env-file=.env src/db/reset.ts && npm run db:migrate && npm run db:seed",
    "db:migrate:test":"node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:test": " tsx --env-file=.env.test src/db/seed.ts ",
    "db:reset:test": "tsx --env-file=.env.test src/db/reset.ts && npm run db:migrate:test && npm run db:seed:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
